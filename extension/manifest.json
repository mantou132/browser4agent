{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_appName__",
  "version": "0.1.5",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser4agent@xianqiao.wang",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "description": "__MSG_appDescription__",
  "permissions": [
    "nativeMessaging",
    "sidePanel",
    "storage",
    "contextMenus",
    "tabs",
    "activeTab",
    "scripting",
    "cookies",
    "alarms",

    "notifications",
    "tabGroups",
    "downloads",
    "history",
    "bookmarks",
    "topSites",
    "browsingData",
    "sessions",
    "webNavigation",
    "webRequest",
    "search",

    "offscreen",

    "pageCapture",
    "favicon"
  ],
  "host_permissions": ["<all_urls>"],
  "chrome:background": { "service_worker": "background.js" },
  "firefox:background": { "scripts": ["background.js"] },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": "icon128.png",
    "default_title": "__MSG_actionTitle__"
  },
  "side_panel": {
    "default_path": "pages/agent-panel.html"
  },
  "firefox:sidebar_action": {
    "default_panel": "pages/agent-panel.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": "icon128.png"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "devtools_page": "devtools/devtools.html",
  "content_scripts": [
    {
      "matches": ["*://*.feishu.cn/*"],
      "js": ["read-content-hacks/feishu.cn.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["prepare.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
