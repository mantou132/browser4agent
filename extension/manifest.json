{
  "manifest_version": 3,
  "name": "Browser for AI Agent",
  "version": "0.1.0",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "browser4agent@xianqiao.wang"
    }
  },
  "description": "让 AI Agent 读取浏览器标签页内容、操控浏览器（管理标签页/窗口等），调用标签页工具",
  "permissions": ["tabs", "nativeMessaging", "scripting", "activeTab", "cookies", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "chrome:background": { "service_worker": "background.js" },
  "firefox:background": { "scripts": ["background.js"] },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": "icon128.png",
    "default_title": "MCP 工具"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["*://*.feishu.cn/*"],
      "js": ["read-content-hacks/feishu.cn.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["prepare.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
